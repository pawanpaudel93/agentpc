#!/bin/sh
# agentpc: a systemd generator (/etc/systemd/system-generators/agentpc-fex) that lets services
# whose ExecStart is an x86 program run through FEX. FEX writes and runs translated code and
# sets the process personality; MemoryDenyWriteExecute= and LockPersonality= forbid both, and
# the service would die at start with a SIGSEGV inside FEX. For each such unit, write a drop-in
# that allows them. It runs at boot and on every `systemctl daemon-reload`; arm64 services keep
# their settings. $1 is the generator output directory.
# AGENTPC_UNIT_DIRS overrides where units are looked for (tests); systemd sets no such thing.
out=${1:-/run/systemd/generator}
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Highest precedence first, as systemd reads them.
dirs=${AGENTPC_UNIT_DIRS:-/etc/systemd/system /run/systemd/system /usr/local/lib/systemd/system /usr/lib/systemd/system}
is_x86() {
    [ -f "$1" ] || return 1
    [ "$(od -An -c -N 4 "$1" 2>/dev/null | tr -d ' ')" = 177ELF ] || return 1
    case $(od -An -t u2 -j 18 -N 2 "$1" 2>/dev/null | tr -d ' ') in 62|3) return 0 ;; esac
    return 1
}
# Drop-in directories that apply to a unit, most general first: every service (service.d),
# each dash prefix of its name (a-.service.d, a-b-.service.d), its template (a@.service.d),
# then the unit's own.
dropin_dirs() {
    u=$1
    printf '%s\n' service.d
    base=${u%.service}
    stem=${base%%@*}
    p=
    rest=$stem
    while [ "${rest#*-}" != "$rest" ]; do
        p=$p${rest%%-*}-
        rest=${rest#*-}
        printf '%s\n' "$p.service.d"
    done
    [ "$stem" != "$base" ] && printf '%s\n' "$stem@.service.d"
    printf '%s\n' "$u.d"
}
hard='^[[:space:]]*(MemoryDenyWriteExecute|LockPersonality)[[:space:]]*=[[:space:]]*(yes|true|on|1)'
# Only units that set either directive need a look: one grep per directory finds them. A
# setting in a drop-in for many units (all services, a prefix, a template) puts every
# service in question.
# shellcheck disable=SC2086
found=$(for dir in $dirs; do
    [ -d "$dir" ] || continue
    grep -lsE "$hard" "$dir"/*.service "$dir"/*.service.d/*.conf "$dir"/service.d/*.conf
done | sed -E 's|\.d/[^/]*$||; s|.*/||' | sort -u)
if printf '%s\n' "$found" | grep -qxE 'service|.*-\.service|.*@\.service'; then
    # shellcheck disable=SC2086
    units=$(for dir in $dirs; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*.service; do [ -f "$f" ] && printf '%s\n' "${f##*/}"; done
    done | sort -u)
else
    units=$found
fi
for unit in $units; do
    file=
    # shellcheck disable=SC2086
    for dir in $dirs; do
        if [ -f "$dir/$unit" ]; then file=$dir/$unit; break; fi
    done
    [ -n "$file" ] || continue
    # Its drop-ins from every directory and every level, in name order; a name in a more
    # specific level, or a higher directory, hides the same name elsewhere. Applied after the
    # unit file, so the last ExecStart= wins.
    dropins=$(dropin_dirs "$unit" | awk '{ print NR "\t" $0 }' | sort -rn | cut -f2- |
        while IFS= read -r d; do
            # shellcheck disable=SC2086
            for dir in $dirs; do
                for f in "$dir/$d"/*.conf; do [ -f "$f" ] && printf '%s\n' "$f"; done
            done
        done | awk -F/ '!seen[$NF]++ { print $NF "\t" $0 }' | LC_ALL=C sort | cut -f2-)
    # Nothing here sets the options (a template or prefix drop-in that does applies to other
    # units): leave it alone.
    { cat "$file"; for f in $dropins; do cat "$f"; done; } 2>/dev/null | grep -qE "$hard" || continue
    # Every ExecStart= that stays (a oneshot unit may have several), prefixes (-@:+!)
    # dropped; an empty one clears those before it.
    cmds=$( { cat "$file"; for f in $dropins; do cat "$f"; done; } 2>/dev/null |
        sed -n 's/^[[:space:]]*ExecStart[[:space:]]*=[[:space:]]*//p' |
        awk '{ sub(/^[-@:+!]+/, "") } $0 == "" { n = 0; next } { c[++n] = $0 }
             END { for (i = 1; i <= n; i++) print c[i] }')
    x86=
    while IFS= read -r exe; do
        # The program: the first word, or a quoted path.
        case $exe in
            \"*) exe=${exe#\"}; exe=${exe%%\"*} ;;
            \'*) exe=${exe#\'}; exe=${exe%%\'*} ;;
            *) exe=${exe%%[[:space:]]*} ;;
        esac
        [ -n "$exe" ] || continue
        case $exe in /*) ;; *) exe=$(command -v "$exe") || continue ;; esac
        if is_x86 "$exe"; then x86=$exe; break; fi
    done <<EOF_CMDS
$cmds
EOF_CMDS
    [ -n "$x86" ] || continue
    # Drop-ins apply in name order whatever their directory or level (byte order, as
    # systemd compares them), so this one must sort after every one that applies: a unit's
    # own hardening.conf would set the options back.
    name=zz-agentpc-fex.conf
    last=$(for f in $dropins; do printf '%s\n' "${f##*/}"; done | LC_ALL=C sort | tail -n 1)
    if [ -n "$last" ] && [ "$(printf '%s\n%s\n' "$name" "$last" | LC_ALL=C sort | tail -n 1)" != "$name" ]; then
        name=${last%.conf}~agentpc-fex.conf
    fi
    mkdir -p "$out/$unit.d"
    printf '%s\n' "# agentpc-fex generator: $x86 is an x86 program, which FEX runs." \
        '[Service]' 'MemoryDenyWriteExecute=no' 'LockPersonality=no' > "$out/$unit.d/$name"
done
exit 0
