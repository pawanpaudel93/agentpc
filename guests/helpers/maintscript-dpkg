#!/bin/sh
# agentpc (ubuntu-x86apps): /usr/local/bin/dpkg. Inside an amd64/i386 package's maintainer
# script (DPKG_MAINTSCRIPT_ARCH set by dpkg), `dpkg --print-architecture` is that package's
# architecture, since its programs run through FEX; everything else is the real dpkg.
# AGENTPC_REAL (default /usr/bin) is where the real one is; tests point it at stubs.
real=${AGENTPC_REAL:-/usr/bin}/dpkg
case ${DPKG_MAINTSCRIPT_ARCH:-}:${1:-} in
    amd64:--print-architecture | i386:--print-architecture)
        [ $# -eq 1 ] && { echo "$DPKG_MAINTSCRIPT_ARCH"; exit 0; } ;;
esac
exec "$real" "$@"
