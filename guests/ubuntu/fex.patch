# agentpc's changes to FEX, applied by x86apps.sh before building it static-pie.
# 1. Inside a Docker or Podman container, run without FEXServer or a RootFS overlay.
# 2. Fix an madvise overshoot that corrupts memory in a static-pie build.

diff --git a/Source/Tools/FEXInterpreter/FEXInterpreter.cpp b/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
index c2eb2fb..9986222 100644
--- a/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
+++ b/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
@@ -437,10 +437,17 @@ int main(int argc, char** argv, char** const envp) {
   }
 
   // Ensure FEXServer is setup before config options try to pull CONFIG_ROOTFS
-  auto SelfPath = FEX::GetSelfPath();
-  if (!FEXServerClient::SetupClient(SelfPath.value_or(argv[0]))) {
-    LogMan::Msg::EFmt("FEXServerClient: Failure to setup client");
-    return -1;
+  // agentpc: in a Docker or Podman container FEXServer isn't reachable and the image is
+  // already an x86 root filesystem, so run without the server or a RootFS overlay.
+  const bool InContainer = FHU::Filesystem::Exists("/.dockerenv") || FHU::Filesystem::Exists("/run/.containerenv");
+  if (InContainer) {
+    FEXCore::Config::Set(FEXCore::Config::CONFIG_ROOTFS, "");
+  } else {
+    auto SelfPath = FEX::GetSelfPath();
+    if (!FEXServerClient::SetupClient(SelfPath.value_or(argv[0]))) {
+      LogMan::Msg::EFmt("FEXServerClient: Failure to setup client");
+      return -1;
+    }
   }
 
   FEX_CONFIG_OPT(LDPath, ROOTFS);
@@ -489,7 +496,25 @@ int main(int argc, char** argv, char** const envp) {
     putenv(HostEnv.data());
   }
 
-  ELFCodeLoader Loader {Program.ProgramPath, FEXFD, LDPath(), Args, ParsedArgs, envp, &Environment};
+  // agentpc: the container doesn't see the host's config, whose Env sets this: Go programs
+  // crash under FEX when the runtime preempts goroutines with signals.
+  fextl::vector<char*> ContainerEnvp;
+  char** const GuestEnvp = [&] {
+    if (!InContainer) {
+      return envp;
+    }
+    bool HasGoDebug = false;
+    for (auto e = envp; *e; ++e) {
+      ContainerEnvp.push_back(*e);
+      HasGoDebug |= strncmp(*e, "GODEBUG=", 8) == 0;
+    }
+    if (!HasGoDebug) {
+      ContainerEnvp.push_back(const_cast<char*>("GODEBUG=asyncpreemptoff=1"));
+    }
+    ContainerEnvp.push_back(nullptr);
+    return ContainerEnvp.data();
+  }();
+  ELFCodeLoader Loader {Program.ProgramPath, FEXFD, LDPath(), Args, ParsedArgs, GuestEnvp, &Environment};
   FEXCore::Config::Set(FEXCore::Config::CONFIG_IS64BIT_MODE, Loader.Is64BitMode() ? "1" : "0");
 
   if (!Loader.ELFWasLoaded()) {
diff --git a/FEXCore/Source/Utils/Allocator/64BitAllocator.cpp b/FEXCore/Source/Utils/Allocator/64BitAllocator.cpp
index b136ec5..2ae8a21 100644
--- a/FEXCore/Source/Utils/Allocator/64BitAllocator.cpp
+++ b/FEXCore/Source/Utils/Allocator/64BitAllocator.cpp
@@ -123,7 +123,10 @@ private:
 
       // Use madvise to set the full tracking region to zero.
       // This ensures unused pages are zero, while not having the backing pages consuming memory.
-      auto* MemoryAsBytes = reinterpret_cast<uint8_t*>(Region->UsedPages.Memory);
+      // agentpc: ManagedSize counts from the start of the region, not from the bitmap that
+      // follows its header, so offset from the region too. Otherwise MADV_DONTNEED runs past
+      // the region's end and zeroes whatever is mapped next (FEX's own data when static-pie).
+      auto* MemoryAsBytes = reinterpret_cast<uint8_t*>(Region);
       const auto TrackingRegionSize = Region->SlabInfo->RegionSize - ManagedSize;
       ::madvise(MemoryAsBytes + ManagedSize, TrackingRegionSize, MADV_DONTNEED);
 
