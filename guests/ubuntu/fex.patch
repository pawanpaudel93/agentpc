--- a/Source/Common/FEXServerClient.cpp
+++ b/Source/Common/FEXServerClient.cpp
@@ -95,6 +95,19 @@ fextl::string GetTempFolder() {
     }
   }
 
+  // agentpc: /tmp is read-only for a systemd service with ProtectSystem=strict and no
+  // PrivateTmp=; use the service's own directories then.
+  if (access("/tmp", W_OK) != 0) {
+    for (const char* Var : {"RUNTIME_DIRECTORY", "STATE_DIRECTORY", "CACHE_DIRECTORY"}) {
+      if (const char* Dirs = getenv(Var)) {
+        fextl::string Dir(Dirs, strcspn(Dirs, ":"));
+        if (access(Dir.c_str(), W_OK) == 0) {
+          return Dir;
+        }
+      }
+    }
+  }
+
   // Fallback to `/tmp/` if no env vars are set.
   // Might not be ideal but we don't have much of a choice.
   return fextl::string {"/tmp"};
