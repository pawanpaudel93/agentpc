#cloud-config
# __SSH_KEY__ is substituted by ./ubuntu-agent when it builds the seed ISO.
hostname: ubuntu-agent
users:
  - name: agent
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: agent
    ssh_authorized_keys: [__SSH_KEY__]

package_update: true
packages:
  - xfce4
  - xfce4-terminal
  - lightdm
  - lightdm-gtk-greeter
  - xserver-xorg
  - dbus-x11
  - at-spi2-core
  - xdotool
  - curl

write_files:
  # X11 session with autologin: Cua Driver fully supports X11 (Wayland only with limits).
  - path: /etc/lightdm/lightdm.conf.d/50-agent.conf
    content: |
      [Seat:*]
      autologin-user=agent
      autologin-session=xfce
      user-session=xfce
  # A blanked or locked screen blocks screenshots and input.
  - path: /etc/X11/xorg.conf.d/10-noblank.conf
    content: |
      Section "ServerFlags"
        Option "BlankTime" "0"
        Option "StandbyTime" "0"
        Option "SuspendTime" "0"
        Option "OffTime" "0"
      EndSection

  # Images are shared, so SSH trusts whichever Mac boots them: agentpc passes its public key
  # as an SMBIOS OEM string (-smbios type=11) and this installs it at every boot.
  - path: /usr/local/sbin/agentpc-ssh-key
    permissions: '0755'
    content: |
      #!/bin/sh
      key=$(dmidecode -t 11 2>/dev/null | sed -n 's/^.*agentpc-ssh-key=//p' | head -n 1)
      [ -n "$key" ] || exit 0
      install -d -m 700 -o agent -g agent /home/agent/.ssh
      printf '%s\n' "$key" > /home/agent/.ssh/authorized_keys
      chown agent:agent /home/agent/.ssh/authorized_keys
      chmod 600 /home/agent/.ssh/authorized_keys
  - path: /etc/systemd/system/agentpc-ssh-key.service
    content: |
      [Unit]
      Description=Install the agentpc host's SSH key
      Before=ssh.service
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/agentpc-ssh-key
      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl enable agentpc-ssh-key.service
  - systemctl set-default graphical.target
  # xfce4 pulls in light-locker, which would lock the agent out of the session.
  - apt-get purge -y light-locker
  # Pinned: the skill and docs describe this version's tools. Bump deliberately. The
  # installer runs a sibling _install-rust.sh if present (else the latest from cua.ai), which
  # sources a sibling _install-common.sh (else the latest from cua.ai), so fetch all three
  # from the same tag and check them. The installer doesn't check the release it downloads,
  # so the installed binaries are checked against the release's own afterwards. On a
  # mismatch the image is never marked ready. Telemetry off: VMs don't report to a third party.
  # Bumping: update every sha256 below (and in guests/arch/build.sh).
  - |
    su - agent -c 'set -e; d=$(mktemp -d); cd "$d"
      raw=https://raw.githubusercontent.com/trycua/cua/cua-driver-rs-v0.30.3/libs/cua-driver/scripts
      curl -fsSLO https://github.com/trycua/cua/releases/download/cua-driver-rs-v0.30.3/install.sh
      curl -fsSLO "$raw/_install-rust.sh"
      curl -fsSLO "$raw/_install-common.sh"
      printf "%s\n" \
        "317ba3a49fdba10f2a7f1b9f392c1bc1b7657f3aae85e1e2e43684cf17a1bf3b  install.sh" \
        "2d7aa18f56b33a04cf79e001f4c48abdee7b54234e5fd5868c9327b4a47568e6  _install-rust.sh" \
        "5bc3aa010eb8667a099b582a9ada9a8f93001745b842cc7cf3cc6c472520cf29  _install-common.sh" |
        sha256sum -c --quiet || { echo "cua-driver installer checksum mismatch" >&2; exit 1; }
      CUA_DRIVER_RS_VERSION=0.30.3 CUA_DRIVER_RS_TELEMETRY_ENABLED=0 bash ./install.sh
      cd ~/.cua-driver/packages/releases/0.30.3-aarch64-unknown-linux-gnu
      printf "%s\n" \
        "b9d31159bc1358c7069173cea0e025e8b3b3febad50cfce8059548a943e87187  cua-driver" \
        "f9f9e0db8cb12ce631bb6b74deec0ece7823bb4e3ff31d48b493e9c4b590c2b9  cua-cursor-theme" |
        sha256sum -c --quiet || { echo "installed cua-driver checksum mismatch" >&2; exit 1; }
      ~/.local/bin/cua-driver telemetry disable; rm -rf "$d"' || exit 1
  - touch /var/lib/cloud/agent-ready
  # VMs cloned from the image boot without a seed; stop cloud-init treating them as
  # new instances and re-running this whole file.
  - touch /etc/cloud/cloud-init.disabled

# Reboot so lightdm starts the autologin session on a fully provisioned system.
power_state:
  mode: reboot
  condition: true
